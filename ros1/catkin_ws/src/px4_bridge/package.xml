<?xml version="1.0"?>
<package format="2">
  <name>px4_bridge</name>
  <version>0.1.0</version>
  <description>Lightweight ROS1 (MAVROS) PX4 control bridge: task queue, offboard, failsafe</description>

  <maintainer email="dev@example.com">px4-bridge</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>mavros_msgs</exec_depend>
  <exec_depend>px4_bridge_msgs</exec_depend>
</package>
